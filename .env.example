# All Around Maintenance — environment variables (set in Vercel → Settings → Environment Variables)

# --- Quote form ---
# The form is on the site. A request is saved when the Supabase names are set and
# supabase/migrations/20261126030000_site_leads.sql has been applied. It is emailed
# when the Resend names are set. Names only; do not commit real values.
RESEND_API_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Used when the service-role key is unset. LEAD_DB_SECRET must match the hash in site_lead_gate.
# SUPABASE_PUBLISHABLE_KEY=
# LEAD_DB_SECRET=
# Inbox that receives quote requests. NOTIFY_EMAIL is used when this is unset.
# LEAD_TO_EMAIL=
# Verified Resend sender. RESEND_FROM is used when this is unset.
# LEAD_FROM_EMAIL=
NOTIFY_EMAIL=
# RESEND_FROM=

# --- Public facts (leave unset until confirmed with the owner; nothing unverified is rendered) ---
# NEXT_PUBLIC_SITE_URL=https://www.allaroundmaintenanceinc.com
# NEXT_PUBLIC_BUSINESS_EMAIL=
# NEXT_PUBLIC_BUSINESS_HOURS="Mon–Fri 8 AM – 5:30 PM"
# NEXT_PUBLIC_BUSINESS_STREET_ADDRESS=
# NEXT_PUBLIC_BUSINESS_POSTAL_CODE=
# Only set these if they match the live Google Business Profile.
# NEXT_PUBLIC_AGGREGATE_RATING_VALUE=
# NEXT_PUBLIC_AGGREGATE_REVIEW_COUNT=

# --- Analytics (optional) ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
