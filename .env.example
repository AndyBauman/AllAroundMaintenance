# All Around Maintenance — environment variables (set in Vercel → Settings → Environment Variables)

# --- Lead form: NOT USED AT LAUNCH ---
# The online form is switched off (LEAD_FORM_ENABLED = false in src/lib/constants.ts), so none of the
# three variables below are read. Set them only when you turn the form on.
RESEND_API_KEY=
# Where new leads are emailed (comma-separated for several inboxes).
NOTIFY_EMAIL=
# Optional: From header. Must be a sender on a domain verified in Resend.
# RESEND_FROM="All Around Maintenance Website <leads@allaroundmaintenanceinc.com>"

# --- Public facts (leave unset until confirmed with the owner; nothing unverified is rendered) ---
# NEXT_PUBLIC_SITE_URL=https://www.allaroundmaintenanceinc.com
# NEXT_PUBLIC_BUSINESS_EMAIL=
# NEXT_PUBLIC_BUSINESS_HOURS="Mon–Fri 8 AM – 5:30 PM"
# NEXT_PUBLIC_BUSINESS_STREET_ADDRESS=
# NEXT_PUBLIC_BUSINESS_POSTAL_CODE=
# Only set these if they match the live Google Business Profile.
# NEXT_PUBLIC_AGGREGATE_RATING_VALUE=
# NEXT_PUBLIC_AGGREGATE_REVIEW_COUNT=

# --- Analytics (optional) ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
